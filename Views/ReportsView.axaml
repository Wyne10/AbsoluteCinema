<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AbsoluteCinema.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:AbsoluteCinema.Views"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AbsoluteCinema.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid Margin="24" ColumnDefinitions="*,16,3*" RowDefinitions="Auto,*">

        <!-- Header -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,24">
            <TextBlock Text="Отчёты"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Генерация еженедельных, ежемесячных и ежеквартальных отчётов"
                       Opacity="0.7"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Left panel -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <!-- Параметры отчёта -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Параметры отчёта"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <!-- Тип -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Тип отчёта" Opacity="0.7" FontSize="12"/>
                        <ComboBox Name="ReportType"
                                  PlaceholderText="Выберите тип"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding ReportTypes}"
                                  SelectedItem="{Binding SelectedReportType}"/>
                    </StackPanel>

                    <!-- Дата -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Период" Opacity="0.7" FontSize="12"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="24">
                            <Viewbox MaxHeight="180" MaxWidth="200">
                                <Calendar Name="PeriodCalendar"
                                          SelectionMode="SingleRange"/>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="Выбранный период:"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Name="StartDateText"
                                               Text="Начало: —"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                    <TextBlock Name="EndDateText"
                                               Text="Конец: —"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопка Сгенерировать -->
            <Button Grid.Row="1"
                    Command="{Binding GenerateReportCommand}"
                    Content="Сгенерировать отчёт"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,16,0,16"
                    Padding="16,12"
                    Theme="{DynamicResource SolidButton}"/>

            <!-- Скачанные файлы -->
            <views:FilesListView Grid.Row="2" DataContext="{Binding}"/>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns"/>

        <!-- Preview panel -->
        <views:PreviewPanelView Grid.Row="1" Grid.Column="2" DataContext="{Binding}"/>
    </Grid>
</UserControl>
