<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AbsoluteCinema.ViewModels"
             xmlns:models="using:AbsoluteCinema.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:avaloniaPdfViewer="clr-namespace:AvaloniaPdfViewer;assembly=AvaloniaPdfViewer"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AbsoluteCinema.Views.ReportsView"
             x:DataType="vm:ReportsViewModel">

    <Grid Margin="24" ColumnDefinitions="*,16,3*" RowDefinitions="Auto,*">

        <!-- Header -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,24">
            <TextBlock Text="Отчёты"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Генерация еженедельных, ежемесячных и ежеквартальных отчётов"
                       Opacity="0.7"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Left panel -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,Auto,*">

            <!-- Параметры отчёта -->
            <Border Grid.Row="0"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Параметры отчёта"
                               FontSize="16"
                               FontWeight="SemiBold"/>

                    <!-- Тип -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Тип отчёта" Opacity="0.7" FontSize="12"/>
                        <ComboBox Name="ReportType" 
                                  PlaceholderText="Выберите тип" 
                                  HorizontalAlignment="Stretch" 
                                  ItemsSource="{Binding ReportTypes}" 
                                  SelectedItem="{Binding SelectedReportType}"/>
                    </StackPanel>

                    <!-- Дата -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Период" Opacity="0.7" FontSize="12"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="24">
                            <Viewbox MaxHeight="180" MaxWidth="200">
                                <Calendar Name="PeriodCalendar"
                                          SelectionMode="SingleRange"/>
                            </Viewbox>
                            <StackPanel VerticalAlignment="Center" Spacing="8">
                                <TextBlock Text="Выбранный период:"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <StackPanel Spacing="4">
                                    <TextBlock Name="StartDateText"
                                               Text="Начало: —"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                    <TextBlock Name="EndDateText"
                                               Text="Конец: —"
                                               FontSize="12"
                                               Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Кнопка Сгенерировать -->
            <Button Grid.Row="1"
                    Command="{Binding GenerateReportCommand}"
                    Content="Сгенерировать отчёт"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Margin="0,16,0,16"
                    Padding="16,12"
                    Theme="{DynamicResource SolidButton}"/>

            <!-- Скачанные файлы -->
            <Border Grid.Row="2"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    CornerRadius="8"
                    Padding="20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Скачанные файлы"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <ListBox Name="FilesListBox"
                             ItemsSource="{Binding ReportFiles}"
                             SelectedItem="{Binding SelectedFile}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ReportFile">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"
                                              Width="16" Height="16"/>
                                    <TextBlock Text="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
        
        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns"/>

        <!-- Preview panel -->
        <Border Grid.Row="1" Grid.Column="2"
                Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                CornerRadius="8"
                Padding="20">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="Предпросмотр"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,12"/>

                <Grid>
                    <!-- Placeholder when no file selected -->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12"
                                IsVisible="{Binding CurrentPreview, 
                                Converter={x:Static ObjectConverters.Equal}, 
                                ConverterParameter={x:Static vm:PreviewType.None}}">
                        <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11zM9 13h6v2H9v-2zm0 4h6v2H9v-2zm0-8h4v2H9V9z"
                                  Width="48" Height="48"
                                  Opacity="0.5"/>
                        <TextBlock Text="Выберите файл для предпросмотра"
                                   Opacity="0.5"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- PDF Preview -->
                    <avaloniaPdfViewer:PdfViewer
                        Source="{Binding PdfPreviewPath}"
                        IsVisible="{Binding CurrentPreview,
                        Converter={x:Static ObjectConverters.Equal},
                        ConverterParameter={x:Static vm:PreviewType.Pdf}}"/>

                    <!-- Excel Preview (DataGrid) -->
                    <DataGrid Name="ExcelDataGrid"
                              IsVisible="{Binding CurrentPreview,
                              Converter={x:Static ObjectConverters.Equal},
                              ConverterParameter={x:Static vm:PreviewType.Excel}}"
                              IsReadOnly="True"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="All"/>

                    <!-- Unsupported -->
                    <StackPanel IsVisible="{Binding CurrentPreview, 
                                Converter={x:Static ObjectConverters.Equal}, 
                                ConverterParameter={x:Static vm:PreviewType.Unsupported}}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="12">
                        <PathIcon Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                                  Width="48" Height="48"
                                  Opacity="0.5"/>
                        <TextBlock Text="Предпросмотр не поддерживается"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>