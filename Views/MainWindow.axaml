<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AbsoluteCinema.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AbsoluteCinema.Views"
        mc:Ignorable="d" d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="AbsoluteCinema.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="AbsoluteCinema">

    <Grid ColumnDefinitions="Auto,*">
        <views:NavigationMenuView Grid.Column="0" DataContext="{Binding}"/>
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}"/>
    </Grid>

</Window>
