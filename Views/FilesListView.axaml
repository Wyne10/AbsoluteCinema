<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AbsoluteCinema.ViewModels"
             xmlns:models="using:AbsoluteCinema.Models"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="AbsoluteCinema.Views.FilesListView"
             x:DataType="vm:FilePreviewViewModel">

    <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
            CornerRadius="8"
            Padding="20">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <Button DockPanel.Dock="Right"
                        Command="{Binding OpenFilesFolderCommand}"
                        Background="Transparent"
                        Padding="4"
                        ToolTip.Tip="Открыть папку">
                    <PathIcon Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"
                              Width="16" Height="16"/>
                </Button>
                <TextBlock Text="Скачанные файлы"
                           FontSize="16"
                           FontWeight="SemiBold"/>
            </DockPanel>

            <ListBox Name="FilesListBox"
                     ItemsSource="{Binding DocumentFiles}"
                     SelectedItem="{Binding SelectedFile}"
                     SelectionMode="Single">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DocumentFile">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PathIcon Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm4 18H6V4h7v5h5v11z"
                                      Width="16" Height="16"/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
