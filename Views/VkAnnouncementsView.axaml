<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AbsoluteCinema.ViewModels"
             xmlns:models="using:AbsoluteCinema.Models"
             xmlns:asyncImageLoader="using:AsyncImageLoader"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="AbsoluteCinema.Views.VkAnnouncementsView"
             x:DataType="vm:VkAnnouncementsViewModel">

    <Grid Margin="24" ColumnDefinitions="*,16,3*" RowDefinitions="Auto,*">

        <!-- Header -->
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,24">
            <TextBlock Text="VK анонсы"
                       FontSize="28"
                       FontWeight="SemiBold"/>
            <TextBlock Text="Выберите трейлеры и опубликуйте анонсы на стене группы VK"
                       Opacity="0.7"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Left panel -->
        <Grid Grid.Row="1" Grid.Column="0" RowDefinitions="Auto,*">

            <!-- Buttons and status -->
            <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,16">
                <Button Command="{Binding LoadMoviesCommand}"
                        Content="Загрузить фильмы"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,12"
                        Theme="{DynamicResource SolidButton}"/>
                <Button Command="{Binding PublishCommand}"
                        Content="Опубликовать в VK"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Padding="16,12"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding SelectAllCommand}"
                            Content="Выбрать все"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="8,6"
                            FontSize="12"/>
                    <Button Command="{Binding DeselectAllCommand}"
                            Content="Снять выбор"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Padding="8,6"
                            FontSize="12"/>
                </StackPanel>
                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding IsLoading}"
                             Height="4"/>
                <ProgressBar Value="{Binding PublishProgress}"
                             Maximum="100"
                             IsVisible="{Binding IsPublishing}"
                             Height="4"/>
                <TextBlock Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           FontSize="11"
                           Opacity="0.7"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Reserved space for future schedule posting -->
            <Border Grid.Row="1"/>
        </Grid>

        <GridSplitter Grid.Row="1" Grid.Column="1" ResizeDirection="Columns"/>

        <!-- Right panel: movie selection -->
        <ScrollViewer Grid.Row="1" Grid.Column="2">
            <ItemsControl ItemsSource="{Binding Movies}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:VkAnnouncementMovie">
                        <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                                <!-- Selection checkbox -->
                                <CheckBox Grid.Column="0"
                                          IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0"/>

                                <!-- Cover image -->
                                <Border Grid.Column="1"
                                        Width="80" Height="114"
                                        CornerRadius="4"
                                        ClipToBounds="True"
                                        Margin="0,0,12,0">
                                    <Panel>
                                        <Image asyncImageLoader:ImageLoader.Source="{Binding CoverUrl}"
                                               Stretch="UniformToFill"/>
                                        <Border Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                                                IsVisible="{Binding CoverUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                            <PathIcon Data="M18 4v1h-2V4c0-.55-.45-1-1-1H9c-.55 0-1 .45-1 1v1H6V4c0-.55-.45-1-1-1s-1 .45-1 1v16c0 .55.45 1 1 1s1-.45 1-1v-1h2v1c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-1h2v1c0 .55.45 1 1 1s1-.45 1-1V4c0-.55-.45-1-1-1s-1 .45-1 1z"
                                                       Width="24" Height="24"
                                                       Opacity="0.3"/>
                                        </Border>
                                    </Panel>
                                </Border>

                                <!-- Movie info -->
                                <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding ShortDescription}"
                                               FontSize="12"
                                               Opacity="0.7"
                                               TextWrapping="Wrap"
                                               MaxLines="3"
                                               IsVisible="{Binding ShortDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    <ComboBox ItemsSource="{Binding TrailerOptions}"
                                              SelectedItem="{Binding SelectedTrailer}"
                                              PlaceholderText="Выберите трейлер"
                                              HorizontalAlignment="Stretch">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:TrailerOption">
                                                <TextBlock Text="{Binding Title}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
