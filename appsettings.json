{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/.log", "rollingInterval": "Day" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Movie": {
    "Poiskkino": {
      "ApiToken": ""
    },
    "Kinoplan": {
      "ApiToken": ""
    }
  },
  "Report": {
    "Root": {
      "RootPath": ""
    },
    "Monthly": {
      "TemplatePath": ""
    },
    "Quarterly": {
      "TemplatePath": ""
    }
  },
  "Schedule": {
    "Root": {
      "RootPath": ""
    },
    "Repertoire": {
      "TemplatePath": ""
    }
  }
}