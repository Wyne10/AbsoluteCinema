      "RootPath": ""
    },
    "Monthly": {
      "TemplatePath": ""
    },
    "Quarterly": {
      "TemplatePath": ""
    }
  },
  "Trailer": {
    "RootPath": "",
    "FfmpegPath": "ffmpeg"
  },
  "Schedule": {
    "Root": {
      "RootPath": ""
    },
    "Repertoire": {
      "TemplatePath": ""
    }
  },
  "Vk": {
    "AccessToken": "",
    "GroupId": 0
  },
